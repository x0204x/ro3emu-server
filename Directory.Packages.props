<Project>

  <!-- One version per package for the whole repository (NuGet central package management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity bundles and their textures, for the panel's icons from the player's client (MIT both). -->
    <PackageVersion Include="AssetRipper.TextureDecoder" Version="2.6.3" />
    <PackageVersion Include="AssetsTools.NET" Version="3.0.5" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="KeraLua" Version="1.4.11" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- Roslyn for the server's source generator: no newer than the compiler of the oldest SDK band in use. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
