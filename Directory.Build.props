<Project>

  <!-- Quality gates shared by every project; each project file keeps its own target framework and features. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A known vulnerable package, direct or transitive (NuGet audit, NU1901-NU1904), fails the build like any other
         warning: update it (Dependabot proposes the fix) or, for an accepted advisory, suppress that advisory alone
         with <NuGetAuditSuppress> and a reason. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Rules broken by code that predates this setting are listed, with their counts, in .editorconfig. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
