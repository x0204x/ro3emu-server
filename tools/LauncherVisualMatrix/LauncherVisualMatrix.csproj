<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ro3Emu.Launcher\Ro3Emu.Launcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack URIs in the launcher resolve against the visual tool's entry assembly during off-screen rendering. -->
    <Resource Include="..\..\src\Ro3Emu.Launcher\PrivateAssets\Assets\**\*"
              Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
              Condition="Exists('..\..\src\Ro3Emu.Launcher\PrivateAssets\Assets')" />
  </ItemGroup>

</Project>
