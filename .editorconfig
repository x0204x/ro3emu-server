root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# layout, checked in CI by `dotnet format whitespace`. Short initializers and blocks stay on one line; members of
# a multi-line initializer are not split one per line.
[*.cs]
max_line_length = 120
csharp_new_line_before_open_brace = all
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
# Enforced in the build (EnforceCodeStyleInBuild): every file outside the client projects is file-scoped.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
# Collections are created with [] where the target type allows it.
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
# A class whose constructor only stores its parameters uses a primary constructor.
csharp_style_prefer_primary_constructors = true
dotnet_diagnostic.IDE0290.severity = warning
# Field names: const and static readonly fields are PascalCase, every other private field is _camelCase.
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_rule.constant_fields_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.constant_fields_are_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

# Analyzer baseline: rules of AnalysisLevel 10.0-recommended and of the style above that older code still breaks, each
# with its number of violations. They show as suggestions; every other rule fails the build. CI checks the numbers
# (dotnet run --project tools/AnalyzerBaseline -c Release): more violations fail, and fewer fail until the number is
# lowered; a number higher than in the parent commit fails too, so new code cannot add any. Delete a rule's two lines once it reaches zero. The counts are the ones of the
# SDK band global.json pins: after an SDK update, run the tool and write the numbers it prints. IDE1006 stays: the
# fields of DbPlan types and of the values they hold keep their names, because EconomyChildIntent and
# EventPlanFingerprint write those names into stored receipts (ReceiptFieldNamesTests pins them).
# 22: types that own disposable fields should be disposable
dotnet_diagnostic.CA1001.severity = suggestion
# 29: do not declare visible instance fields
dotnet_diagnostic.CA1051.severity = suggestion
# 390: specify IFormatProvider
dotnet_diagnostic.CA1305.severity = suggestion
# 55: specify StringComparison for correctness
dotnet_diagnostic.CA1310.severity = suggestion
# 1: use nameof
dotnet_diagnostic.CA1507.severity = suggestion
# 64: identifiers should not contain underscores
dotnet_diagnostic.CA1707.severity = suggestion
# 5: identifiers should not have an incorrect suffix
dotnet_diagnostic.CA1711.severity = suggestion
# 3: identifiers should not match keywords
dotnet_diagnostic.CA1716.severity = suggestion
# 4: identifiers should not contain type names
dotnet_diagnostic.CA1720.severity = suggestion
# 16: parameter names should match the base declaration
dotnet_diagnostic.CA1725.severity = suggestion
# 1: do not initialize unnecessarily
dotnet_diagnostic.CA1805.severity = suggestion
# 163: mark members as static
dotnet_diagnostic.CA1822.severity = suggestion
# 372: use LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = suggestion
# 59: use concrete types for performance
dotnet_diagnostic.CA1859.severity = suggestion
# 100: avoid constant arrays as arguments
dotnet_diagnostic.CA1861.severity = suggestion
# 10: cache and reuse JsonSerializerOptions
dotnet_diagnostic.CA1869.severity = suggestion
# 144: avoid potentially expensive logging
dotnet_diagnostic.CA1873.severity = suggestion
# 15: instantiate argument exceptions correctly
dotnet_diagnostic.CA2208.severity = suggestion
# 28: naming rule violations (fields persisted by name, see above)
dotnet_diagnostic.IDE1006.severity = suggestion

# The client projects keep their block-scoped namespaces (built only against a local client).
[src/Ro3Emu.{ClientHooks,Loc}/**.cs]
csharp_style_namespace_declarations = block_scoped:silent
# Members inherited from the client's obfuscated classes differ only by case (Obf_KkD, Obf_kkD). CI builds without the
# client, so it never sees this rule fail here: only a local build against the client does.
dotnet_diagnostic.CA1708.severity = none

# Projects that build only against a local client keep their style rules as suggestions.
[src/Ro3Emu.{ClientHooks,Loc,ClientTools}/**.cs]
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0302.severity = suggestion
dotnet_diagnostic.IDE0303.severity = suggestion
dotnet_diagnostic.IDE0304.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion
dotnet_diagnostic.IDE0290.severity = suggestion
dotnet_diagnostic.IDE1006.severity = suggestion

# Generated protobuf code is not ours to format or analyze.
[**/obj/**.cs]
generated_code = true

[*.{json,csproj,props,targets,slnx,xml,yml,yaml,js,mjs,cjs,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
