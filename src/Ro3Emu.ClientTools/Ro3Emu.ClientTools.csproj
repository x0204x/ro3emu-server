<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Builds the client hooks, so it needs a local client (never in CI): warnings stay warnings here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- dotnet publish -c Release -r win-x64 gives one self-contained exe for players. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" />
    <ProjectReference Include="..\Ro3Emu.Patcher\Ro3Emu.Patcher.csproj" />
  </ItemGroup>

  <!-- The client-side hooks DLL travels inside the tool. -->
  <ItemGroup>
    <ProjectReference Include="..\Ro3Emu.ClientHooks\Ro3Emu.ClientHooks.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\Ro3Emu.ClientHooks\bin\$(Configuration)\netstandard2.1\Ro3Emu.ClientHooks.dll" LogicalName="Ro3Emu.ClientHooks.dll" />
    <ProjectReference Include="..\Ro3Emu.Loc\Ro3Emu.Loc.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\Ro3Emu.Loc\bin\$(Configuration)\netstandard2.1\Ro3Emu.Loc.dll" LogicalName="Ro3Emu.Loc.dll" />
  </ItemGroup>

</Project>
