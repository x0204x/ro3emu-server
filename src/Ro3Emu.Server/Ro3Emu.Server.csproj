<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- One latency-bound game loop: workstation concurrent GC measured p99 pause 10 ms and 1.6 GB working set in a
         500-login storm, against 118 ms and 2.9 GB with the web SDK's default server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phonest gate schemas, regenerated from the client's Phonest.Proto descriptors (tools/ProtoDump). -->
    <Protobuf Include="Protos\phonest\*.proto" ProtoRoot="Protos\phonest" GrpcServices="None" />
    <!-- RO3 game messages (package romsg & co.), regenerated from the client's LocalProto/proto.pb.bytes. -->
    <Protobuf Include="Protos\romsg\*.proto" ProtoRoot="Protos\romsg" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- The voice frame cipher: one copy for the relay, the bot (through this project) and the in-game client hooks,
         which compile it against the client's own mscorlib. -->
    <Compile Include="..\Ro3Emu.ClientHooks\VoiceCipher.cs" Link="Voice\VoiceCipher.cs" />
    <!-- The bounded client/server skill-trace wire format is shared for the same reason. -->
    <Compile Include="..\Ro3Emu.ClientHooks\SkillTraceProtocol.cs" Link="Game\SkillTraceProtocol.cs" />
    <!-- Emulator-only game message ids: one collision-checked source shared with the patched client. -->
    <Compile Include="..\Ro3Emu.ClientHooks\PrivateMessageIds.cs" Link="Game\PrivateMessageIds.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Typed views of the client's config tables, generated at compile time from Data/Config. -->
    <ProjectReference Include="..\Ro3Emu.Server.Generators\Ro3Emu.Server.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ro3Emu.Tests" />
    <!-- Embedded only: no loose copies next to the server binary. -->
    <Content Remove="Reconstructed\**" />
    <EmbeddedResource Include="Reconstructed\dungeon-monsters.json" LogicalName="Ro3Emu.Server.Reconstructed.dungeon-monsters.json" />
    <EmbeddedResource Include="Reconstructed\scripted-scenes.json" LogicalName="Ro3Emu.Server.Reconstructed.scripted-scenes.json" />
    <EmbeddedResource Include="Reconstructed\ro1-aggressive-monsters.json" LogicalName="Ro3Emu.Server.Reconstructed.ro1-aggressive-monsters.json" />
  </ItemGroup>

</Project>
