<Project Sdk="Microsoft.NET.Sdk">

  <!-- Content-addressed client repository (FastCDC chunks, zstd) and the updater that installs from it.
       Shared by the launcher (install/update) and ClientTools (release). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

</Project>
