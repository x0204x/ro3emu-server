<Project Sdk="Microsoft.NET.Sdk">

  <!-- RO3Emu.exe: the one program players run. Finds or installs the game, exports the game data from it, starts the
       bundled server, patches the client and launches it (README "Quick start"). Published self-contained, single file,
       by tools/release/pack.ps1: win-x64 for players, linux-x64 for server hosts (export, install, server.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RO3Emu</AssemblyName>
    <RootNamespace>Ro3Emu.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <Product>RO3Emu</Product>
    <ApplicationIcon Condition="Exists('..\Ro3Emu.Launcher\ro3emu.ico')">..\Ro3Emu.Launcher\ro3emu.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" />
    <ProjectReference Include="..\Ro3Emu.DataExport\Ro3Emu.DataExport.csproj" />
  </ItemGroup>

  <!-- The client patcher is shared with Ro3Emu.ClientTools (the developers' command line tool). -->
  <ItemGroup>
    <Compile Include="..\Ro3Emu.ClientTools\ClientPatcher.cs" Link="Client\ClientPatcher.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\LoginPreflightPatch.cs" Link="Client\LoginPreflightPatch.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\ControlledMultiInstancePatch.cs" Link="Client\ControlledMultiInstancePatch.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\AsiaProfilePatch.cs" Link="Client\AsiaProfilePatch.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\TextSink.cs" Link="Client\TextSink.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\ImageSwapPatch.cs" Link="Client\ImageSwapPatch.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\AccessFixPatch.cs" Link="Client\AccessFixPatch.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\VoiceStubPatch.cs" Link="Client\VoiceStubPatch.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\Launcher.cs" Link="Client\Launcher.cs" />
    <Compile Include="..\Ro3Emu.ClientTools\VerifiedBaseline.cs" Link="Client\VerifiedBaseline.cs" />
  </ItemGroup>

  <!-- Our English translations (public sources, no client text beyond the strings they translate); merged on the
       player's machine with the client's own English tables into <client>\ro3emu\loc_en.tsv. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Ro3Emu.Loc\translations\*.tsv" LogicalName="translations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ro3Emu.Setup.Tests" />
  </ItemGroup>

</Project>
