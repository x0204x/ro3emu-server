<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game data export from the player's own client (LuaPayload and VFS), with no Java, Node.js or decompiler:
       Lua chunks are decoded and run in a Lua 5.4 VM (KeraLua), the VFS is read directly. Used by RO3Emu.exe
       (src/Ro3Emu.Setup) and the developer tools (tools/LuaDecode, tools/ConfigExport). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KeraLua" />
    <InternalsVisibleTo Include="Ro3Emu.Setup.Tests" />
  </ItemGroup>

</Project>
